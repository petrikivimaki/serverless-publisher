{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://example.com/papyrus/app-config.schema.json",
	"title": "Papyrus app config",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"title",
		"description",
		"site",
		"defaultFile",
		"home",
		"github",
		"localFallback",
		"externalLinks",
		"maps",
		"periodicTable",
		"reading",
		"obsidian",
		"linktree",
		"contentRights",
		"metadata",
		"pageLoadAnimation",
		"appearance",
		"features"
	],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"title": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"site": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"url",
				"hashRouting"
			],
			"properties": {
				"url": {
					"type": "string",
					"description": "Public site URL used when copying hash-based article links."
				},
				"customDomain": {
					"type": "string",
					"description": "Optional custom domain URL that overrides the GitHub Pages URL in copied article links."
				},
				"hashRouting": {
					"type": "boolean",
					"description": "Whether hash-based note deep links are enabled."
				}
			}
		},
		"defaultFile": {
			"type": "string",
			"description": "Markdown path to open when choosing an initial note."
		},
		"home": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"title",
				"subtitle",
				"background"
			],
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1
				},
				"subtitle": {
					"type": "string"
				},
				"background": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"enabled",
						"image",
						"grayscale"
					],
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"image": {
							"type": "string",
							"description": "Optional background image path for the home screen."
						},
						"grayscale": {
							"type": "boolean",
							"description": "Whether the home background image should render in grayscale."
						}
					}
				}
			}
		},
		"github": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"enabled",
				"owner",
				"repo",
				"branch",
				"manifestPath",
				"rootPath",
				"assetRootPath"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"owner": {
					"type": "string"
				},
				"repo": {
					"type": "string"
				},
				"branch": {
					"type": "string",
					"minLength": 1
				},
				"manifestPath": {
					"type": "string",
					"minLength": 1,
					"description": "Path to the generated content manifest in the repository, normally manifest.json at the repository root."
				},
				"rootPath": {
					"type": "string",
					"description": "Optional markdown root directory inside the GitHub repository."
				},
				"assetRootPath": {
					"type": "string",
					"description": "Optional media asset root directory inside the GitHub repository."
				}
			}
		},
		"localFallback": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"enabled",
				"manifest"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"manifest": {
					"type": "string"
				}
			}
		},
		"externalLinks": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"utm"
			],
			"properties": {
				"utm": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"enabled",
						"params"
					],
					"properties": {
						"enabled": {
							"type": "boolean"
						},
						"params": {
							"type": "object",
							"additionalProperties": {
								"type": "string"
							},
							"propertyNames": {
								"pattern": "^utm_[a-z0-9_]+$"
							}
						}
					}
				}
			}
		},
		"maps": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"enabled",
				"fallback",
				"grayscale"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"fallback": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"latitude",
						"longitude",
						"zoom"
					],
					"properties": {
						"latitude": {
							"type": "number",
							"minimum": -90,
							"maximum": 90
						},
						"longitude": {
							"type": "number",
							"minimum": -180,
							"maximum": 180
						},
						"zoom": {
							"type": "number",
							"minimum": 0,
							"maximum": 22
						}
					}
				},
				"grayscale": {
					"type": "boolean"
				}
			}
		},
		"periodicTable": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"linkLabel",
				"linkTemplate"
			],
			"properties": {
				"linkLabel": {
					"type": "string",
					"minLength": 1,
					"description": "Human-readable name of the external element information service."
				},
				"linkTemplate": {
					"type": "string",
					"minLength": 1,
					"pattern": "^https?://.*\\{(?:[zZ]|symbol)\\}.*$",
					"description": "External element URL template containing {Z} for atomic number or {symbol} for the standard element symbol. Both tokens are substituted when present."
				}
			}
		},
		"appearance": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"primaryMenuSide",
				"contentWidth",
				"fontFamily",
				"fontSize",
				"textAlign",
				"lineHeight",
				"theme",
				"soundEnabled",
				"firstDayOfWeek"
			],
			"properties": {
				"primaryMenuSide": {
					"type": "string",
					"enum": [
						"left",
						"right"
					],
					"description": "Side occupied by the primary navigation menu. This is controlled by site configuration and cannot be overridden by readers."
				},
				"contentWidth": {
					"type": "integer",
					"minimum": 560,
					"maximum": 960,
					"multipleOf": 20,
					"description": "Maximum reading measure in pixels."
				},
				"fontFamily": {
					"type": "string",
					"enum": [
						"literary",
						"modern",
						"monospace"
					]
				},
				"fontSize": {
					"type": "integer",
					"minimum": 14,
					"maximum": 24
				},
				"textAlign": {
					"type": "string",
					"enum": [
						"left",
						"center",
						"justify",
						"right"
					]
				},
				"lineHeight": {
					"type": "number",
					"minimum": 1.2,
					"maximum": 2.2
				},
				"theme": {
					"type": "string",
					"enum": [
						"light",
						"sand",
						"ocean",
						"dark"
					]
				},
				"soundEnabled": {
					"type": "boolean",
					"description": "Enables Cuelume interaction sounds by default. Readers can override this preference locally."
				},
				"firstDayOfWeek": {
					"type": "integer",
					"minimum": 0,
					"maximum": 6,
					"description": "0 is Sunday, 1 is Monday, and 6 is Saturday."
				}
			}
		},
		"reading": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"wordsPerMinute"
			],
			"properties": {
				"wordsPerMinute": {
					"type": "integer",
					"minimum": 1,
					"description": "Reading speed used to estimate article reading time."
				}
			}
		},
		"obsidian": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"vault",
				"rootPath"
			],
			"properties": {
				"vault": {
					"type": "string",
					"description": "Obsidian vault name used by obsidian://open links."
				},
				"rootPath": {
					"type": "string",
					"description": "Optional path prefix inside the Obsidian vault."
				}
			}
		},
		"linktree": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"groups"
			],
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1,
					"description": "Optional profile or organization heading shown above the cards."
				},
				"subtitle": {
					"type": "string",
					"minLength": 1,
					"description": "Optional supporting profile text shown below the Linktree title."
				},
				"groups": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"cards"
						],
						"properties": {
							"title": {
								"type": "string",
								"minLength": 1,
								"description": "Optional heading for this card group."
							},
							"cards": {
								"type": "array",
								"minItems": 1,
								"items": {
									"oneOf": [
										{
											"type": "object",
											"additionalProperties": false,
											"required": [
												"label",
												"url"
											],
											"properties": {
												"label": {
													"type": "string",
													"minLength": 1
												},
												"description": {
													"type": "string",
													"minLength": 1
												},
												"icon": {
													"type": "string",
													"minLength": 1,
													"pattern": "^fa-(solid|regular|brands) fa-[a-z0-9-]+(?: fa-[a-z0-9-]+)*$",
													"description": "Optional Font Awesome class identifier that overrides automatic icon selection, such as fa-solid fa-star."
												},
												"url": {
													"type": "string",
													"minLength": 1,
													"description": "HTTP(S), mailto, or plain email destination. Social icons are inferred from this value."
												}
											}
										},
										{
											"type": "object",
											"additionalProperties": false,
											"required": [
												"timeZone"
											],
											"properties": {
												"label": {
													"type": "string",
													"minLength": 1,
													"description": "Optional place or timezone label."
												},
												"icon": {
													"type": "string",
													"minLength": 1,
													"pattern": "^fa-(solid|regular|brands) fa-[a-z0-9-]+(?: fa-[a-z0-9-]+)*$",
													"description": "Optional Font Awesome class identifier that overrides the default clock icon."
												},
												"timeZone": {
													"type": "string",
													"minLength": 1,
													"description": "IANA timezone such as Europe/Helsinki or America/New_York."
												}
											}
										}
									]
								}
							}
						}
					}
				}
			}
		},
		"contentRights": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"copyright",
				"license"
			],
			"properties": {
				"copyright": {
					"type": "string",
					"description": "Default copyright text shown for every article unless frontmatter overrides it."
				},
				"license": {
					"type": "string",
					"description": "Default license shown for every article unless frontmatter overrides it."
				}
			}
		},
		"metadata": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"allowedKeys"
			],
			"properties": {
				"allowedKeys": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"description": "Frontmatter keys allowed to appear in the Metadata block."
				}
			}
		},
		"pageLoadAnimation": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"enabled",
				"backgroundColor",
				"logo",
				"durationMs",
				"fadeMs"
			],
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"backgroundColor": {
					"type": "string",
					"minLength": 1,
					"description": "Theme-independent CSS color used behind the startup logo."
				},
				"logo": {
					"type": "string",
					"description": "Logo image path shown in the page load mask."
				},
				"durationMs": {
					"type": "integer",
					"minimum": 0,
					"description": "Minimum time the load animation remains visible."
				},
				"fadeMs": {
					"type": "integer",
					"minimum": 0,
					"description": "Fade-out duration for the logo and startup mask."
				}
			}
		},
		"features": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"showFrontmatter",
				"showBacklinks",
				"showInsights"
			],
			"properties": {
				"showFrontmatter": {
					"type": "boolean"
				},
				"showBacklinks": {
					"type": "boolean"
				},
				"showInsights": {
					"type": "boolean"
				}
			}
		}
	}
}
