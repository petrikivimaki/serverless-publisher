{
  "title": "Papyrus",
  "description": "A client-side Markdown knowledge base frontend.",
  "site": {
    "url": "https://username.github.io/",
    "customDomain": "",
    "hashRouting": true
  },
  "defaultFile": "README.md",
  "home": {
    "title": "Papyrus",
    "subtitle": "A client-side knowledge base for publishing markdown vaults.",
    "background": {
      "enabled": false,
      "image": "",
      "grayscale": true
    }
  },
  "github": {
    "enabled": false,
    "owner": "",
    "repo": "",
    "branch": "",
    "manifestPath": "manifest.json",
    "rootPath": "",
    "assetRootPath": ""
  },
  "localFallback": {
    "enabled": true,
    "manifest": "docs/manifest.json"
  },
  "externalLinks": {
    "utm": {
      "enabled": false,
      "params": {
        "utm_source": "papyrus",
        "utm_medium": "referral",
        "utm_campaign": "knowledge-base"
      }
    }
  },
  "maps": {
    "enabled": true,
    "fallback": {
      "latitude": 60,
      "longitude": 24,
      "zoom": 11
    },
    "grayscale": false
  },
  "periodicTable": {
    "linkLabel": "PubChem",
    "linkTemplate": "https://pubchem.ncbi.nlm.nih.gov/element/{Z}"
  },
  "reading": {
    "wordsPerMinute": 225
  },
  "obsidian": {
    "vault": "Papyrus",
    "rootPath": ""
  },
  "linktree": {
    "title": "Around Papyrus",
    "subtitle": "Project links, community spaces, and ways to get in touch.",
    "groups": [
      {
        "title": "Project",
        "cards": [
          {
            "label": "GitHub",
            "description": "Source code, issues, and release history",
            "url": "https://github.com/petrikivimaki/papyrus"
          },
          {
            "label": "Papyrus documentation",
            "description": "Guides for publishing a Markdown vault",
            "icon": "fa-solid fa-book-open",
            "url": "https://petrikivimaki.github.io/papyrus/"
          }
        ]
      },
      {
        "title": "Community",
        "cards": [
          {
            "label": "YouTube",
            "description": "Walkthroughs and project updates",
            "url": "https://youtube.com/"
          },
          {
            "label": "Discord",
            "description": "Conversation with the community",
            "url": "https://discord.com/"
          }
        ]
      },
      {
        "title": "Contact",
        "cards": [
          {
            "label": "Email",
            "description": "Questions and collaborations",
            "url": "hello@example.com"
          }
        ]
      },
      {
        "cards": [
          {
            "label": "Helsinki",
            "timeZone": "Europe/Helsinki"
          }
        ]
      }
    ]
  },
  "contentRights": {
    "copyright": "(c) 2026 Papyrus",
    "license": "CC BY 4.0"
  },
  "metadata": {
    "allowedKeys": [
      "title",
      "tags",
      "authors",
      "license",
      "copyright",
      "status"
    ]
  },
  "pageLoadAnimation": {
    "enabled": true,
    "backgroundColor": "rgb(0,0,0)",
    "logo": "images/papyrus-mark.png",
    "durationMs": 1500,
    "fadeMs": 420
  },
  "appearance": {
    "primaryMenuSide": "left",
    "contentWidth": 820,
    "fontFamily": "modern",
    "fontSize": 18,
    "textAlign": "left",
    "lineHeight": 1.68,
    "theme": "dark",
    "soundEnabled": true,
    "firstDayOfWeek": 1
  },
  "features": {
    "showFrontmatter": true,
    "showBacklinks": true,
    "showInsights": true
  }
}
