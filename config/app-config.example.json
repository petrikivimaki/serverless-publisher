{
	"$schema": "./app-config.schema.json",
	"title": "Papyrus",
	"description": "A client-side Markdown knowledge base frontend.",
	"site": {
		"url": "https://your-user-or-org.github.io/",
		"customDomain": "",
		"hashRouting": true
	},
	"defaultFile": "README.md",
	"home": {
		"title": "Papyrus",
		"subtitle": "A client-side knowledge base for publishing markdown vaults.",
		"background": {
			"enabled": true,
			"image": "images/bg-lucerne.jpeg",
			"grayscale": false
		}
	},
	"github": {
		"enabled": true,
		"owner": "your-user-or-org",
		"repo": "your-markdown-vault",
		"branch": "main",
		"manifestPath": "manifest.json",
		"rootPath": "notes",
		"assetRootPath": "images"
	},
	"localFallback": {
		"enabled": false,
		"manifest": "docs/manifest.json"
	},
	"externalLinks": {
		"utm": {
			"enabled": true,
			"params": {
				"utm_source": "papyrus",
				"utm_medium": "referral",
				"utm_campaign": "knowledge-base"
			}
		}
	},
	"maps": {
		"enabled": true,
		"fallback": {
			"latitude": 60.1699,
			"longitude": 24.9384,
			"zoom": 11
		},
		"grayscale": false
	},
	"periodicTable": {
		"linkLabel": "PubChem",
		"linkTemplate": "https://pubchem.ncbi.nlm.nih.gov/element/{Z}"
	},
	"reading": {
		"wordsPerMinute": 225
	},
	"obsidian": {
		"vault": "Your Obsidian vault",
		"rootPath": ""
	},
	"linktree": {
		"title": "Around the web",
		"subtitle": "Social profiles, current projects, and the best places to continue the conversation.",
		"groups": [
			{
				"title": "Social",
				"cards": [
					{
						"label": "GitHub",
						"description": "Repositories and open-source work",
						"url": "https://github.com/your-profile"
					},
					{
						"label": "LinkedIn",
						"description": "Professional notes and updates",
						"url": "https://linkedin.com/in/your-profile"
					},
					{
						"label": "Bluesky",
						"description": "Short observations and new links",
						"url": "https://bsky.app/profile/your-profile"
					},
					{
						"label": "YouTube",
						"description": "Talks, walkthroughs, and recordings",
						"url": "https://youtube.com/@your-channel"
					}
				]
			},
			{
				"title": "Projects",
				"cards": [
					{
						"label": "Project documentation",
						"description": "Guides and release notes",
						"url": "https://example.com/docs"
					},
					{
						"label": "Experimental atlas",
						"description": "A group or company project can live here too",
						"icon": "fa-solid fa-map-location-dot",
						"url": "https://example.org"
					}
				]
			},
			{
				"title": "Contact",
				"cards": [
					{
						"label": "Email",
						"description": "For questions and collaborations",
						"url": "hello@example.com"
					}
				]
			},
			{
				"cards": [
					{
						"label": "Helsinki",
						"timeZone": "Europe/Helsinki"
					}
				]
			}
		]
	},
	"contentRights": {
		"copyright": "(c) 2026 Your Name",
		"license": "CC BY 4.0"
	},
	"metadata": {
		"allowedKeys": [
			"title",
			"tags",
			"authors",
			"license",
			"copyright",
			"status"
		]
	},
	"pageLoadAnimation": {
		"enabled": true,
		"backgroundColor": "rgb(0,0,0)",
		"logo": "images/papyrus-mark.png",
		"durationMs": 1500,
		"fadeMs": 420
	},
	"appearance": {
		"primaryMenuSide": "left",
		"contentWidth": 820,
		"fontFamily": "modern",
		"fontSize": 18,
		"textAlign": "left",
		"lineHeight": 1.68,
		"theme": "light",
		"soundEnabled": true,
		"firstDayOfWeek": 1
	},
	"features": {
		"showFrontmatter": true,
		"showBacklinks": true,
		"showGraph": true
	}
}
